# Copy to config.env, fill in, then: python3 scripts/run.py --env-file config.env ingest
# Never commit the filled-in file. config.env is in .gitignore.

# Figma personal access token. Must have the file_content:read scope;
# other scopes return 403 on /v1/files even when the token is valid.
FIGMA_TOKEN=PASTE_YOUR_FIGMA_TOKEN_HERE
# The key from the file URL: https://www.figma.com/design/<FILE_KEY>/<name>
FIGMA_FILE_KEY=PASTE_YOUR_FILE_KEY_HERE

# Meta Marketing API. A long-lived system-user token with ads_management is the
# reliable choice. The account id may be given with or without the act_ prefix.
META_ACCESS_TOKEN=PASTE_YOUR_META_TOKEN_HERE
META_AD_ACCOUNT=YOUR_AD_ACCOUNT_ID
META_PAGE_ID=YOUR_PAGE_ID
# The ad set that receives the PAUSED ads. Must be non-dynamic
# (is_dynamic_creative=false). Check its destination_type matches your CTA.
META_ADSET_ID=YOUR_ADSET_ID

# Optional
META_IG_USER_ID=YOUR_IG_USER_ID           # Instagram account linked to the Page
META_LEAD_FORM_ID=YOUR_LEAD_FORM_ID       # if set, the CTA opens this instant form
DESTINATION_URL=https://northwind.example/cold-brew
DISPLAY_URL=https://northwind.example      # defaults to the scheme + host of DESTINATION_URL
AD_NAME_PREFIX=NW_                        # ads are named <prefix><set>; defaults to Figma_
CTA_TYPE=LEARN_MORE
GRAPH_API_VERSION=v23.0
# URL_TAGS=utm_source={{site_source_name}}&utm_medium={{placement}}&utm_campaign={{campaign.name}}&utm_content={{ad.name}}
